{
  // ชื่อต้องตรงกับ Worker ที่สร้างไว้บน Cloudflare
  // ดูได้จาก URL: thesis.kongzell008.workers.dev
  "name": "thesis",
  "compatibility_date": "2025-01-01",

  "assets": {
    // โฟลเดอร์ผลลัพธ์ของ vite build (สัมพัทธ์กับโฟลเดอร์ frontend)
    "directory": "./dist",

    // หน้าเว็บใช้ React Router จัดการเส้นทางฝั่งเบราว์เซอร์
    // ถ้าไม่ตั้งค่านี้ คนที่เปิด /login ตรง ๆ จะเจอ 404
    // เพราะไม่มีไฟล์ชื่อ login.html อยู่จริงบนเซิร์ฟเวอร์
    // single-page-application สั่งให้ส่ง index.html กลับไปทุกเส้นทาง
    // แล้วปล่อยให้ React Router ตัดสินใจว่าจะแสดงหน้าไหน
    "not_found_handling": "single-page-application"
  }
}
